class Usuario:

  def __init__(self, id_usuario, nombre, email):
    self.id_usuario = id_usuario
    self.nombre = nombre
    self.email = email


class Bibliotecario(Usuario):

  def __init__(self, id_usuario, nombre, email, seccion, anos_experiencia):
    super().__init__(id_usuario, nombre, email)
    self.seccion = seccion  # e.g., "Infantil", "Hemeroteca"
    self.anos_experiencia = anos_experiencia

  def organizar_seccion(self):
    return (
        f"El bibliotecario {self.nombre} está organizando la sección de"
        f" {self.seccion}."
    )
