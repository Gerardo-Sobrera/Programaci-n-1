class Operacion:

  def __init__(self, a, b):
    self.a = a
    self.b = b

  def resultado(self):
    pass


class Suma(Operacion):

  def resultado(self):
    return self.a + self.b


class Multiplicacion(Operacion):

  def resultado(self):
    return self.a * self.b


# Demostración de polimorfismo
operaciones = [Suma(10, 5), Multiplicacion(4, 6)]

for op in operaciones:
  print(f"El resultado de la operación es: {op.resultado()}")
