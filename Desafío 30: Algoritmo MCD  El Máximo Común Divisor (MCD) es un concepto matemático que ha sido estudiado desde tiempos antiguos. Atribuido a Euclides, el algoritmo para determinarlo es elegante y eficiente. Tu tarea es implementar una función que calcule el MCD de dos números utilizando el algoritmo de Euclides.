def calcular_mcd(a, b):
    """Calcula el Máximo Común Divisor (MCD) de dos números 
    utilizando el algoritmo de Euclides de forma iterativa.
    """
    # El algoritmo se repite hasta que el segundo número sea 0
    while b != 0:
        a, b = b, a % b
        
    # Retornamos el valor absoluto para manejar números negativos de manera correcta
    return abs(a)

# --- Bloque principal de ejecución ---
if __name__ == "__main__":
    num1 = 48
    num2 = 18
    
    mcd = calcular_mcd(num1, num2)
    
    print("--- CÁLCULO DEL MÁXIMO COMÚN DIVISOR (MCD) ---")
    print(f"Números analizados : {num1} y {num2}")
    print(f"El MCD resultante  : {mcd}")
