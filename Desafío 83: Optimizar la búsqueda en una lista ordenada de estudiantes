def busqueda_binaria_estudiantes(lista, estudiante_buscado):
  inicio = 0
  fin = len(lista) - 1

  while inicio <= fin:
    medio = (inicio + fin) // 2

    if lista[medio] == estudiante_buscado:
      return medio  # Devuelve el índice donde fue encontrado
    elif lista[medio] < estudiante_buscado:
      inicio = medio + 1  # Descartamos la mitad izquierda
    else:
      fin = medio - 1  # Descartamos la mitad derecha

  return -1  # No encontrado


# Lista ordenada alfabéticamente
estudiantes_ordenados = ["Ana", "Carlos", "Diego", "Lucía", "Mateo", "Sofía"]
buscado = "Diego"

indice = busqueda_binaria_estudiantes(estudiantes_ordenados, buscado)

if indice != -1:
  print(
      f"El estudiante '{buscado}' fue encontrado en la posición (índice)"
      f" {indice}."
  )
else:
  print(f"El estudiante '{buscado}' no se encuentra en la lista de la clase.")
