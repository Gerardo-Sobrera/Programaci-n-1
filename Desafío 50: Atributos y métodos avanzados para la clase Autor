from datetime import date


class Autor:

  def __init__(self, id_autor, nombre, apellido, fecha_nacimiento, nacionalidad):
    self.id_autor = id_autor
    self.nombre = nombre
    self.apellido = apellido
    self.fecha_nacimiento = fecha_nacimiento  # Formato date o "YYYY-MM-DD"
    self.nacionalidad = nacionalidad
    self.biografia = ""
    self.premios = []
    self.libros_publicados = []  # Almacena ISBNs o títulos

  def agregar_premio(self, premio):
    """Añade un premio literario a la lista del autor."""
    if premio not in self.premios:
      self.premios.append(premio)
      return f"Premio '{premio}' añadido a {self.nombre} {self.apellido}."
    return "El autor ya tiene registrado este premio."

  def calcular_edad(self):
    """Calcula la edad actual del autor o su edad al fallecer (si se extiende)."""
    hoy = date.today()
    edad = (
        hoy.year
        - self.fecha_nacimiento.year
        - (
            (hoy.month, hoy.day)
            < (self.fecha_nacimiento.month, self.fecha_nacimiento.day)
        )
    )
    return edad

  def obtener_info_completa(self):
    """Devuelve un resumen completo del autor."""
    return (
        f"Autor: {self.nombre} {self.apellido} ({self.nacionalidad})\n"
        f"Premios: {', '.join(self.premios) if self.premios else 'Ninguno'}\n"
        f"Libros registrados: {len(self.libros_publicados)}"
    )
