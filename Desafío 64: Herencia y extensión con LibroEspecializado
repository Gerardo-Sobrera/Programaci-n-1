class Libro:

  def __init__(self, titulo, autor):
    self.titulo = titulo
    self.autor = autor


class LibroEspecializado(Libro):

  def __init__(self, titulo, autor, campo_estudio, nivel_especializacion):
    super().__init__(titulo, autor)
    self.campo_estudio = campo_estudio
    self.nivel_especializacion = nivel_especializacion

  def obtener_detalles(self):
    return (
        f"Libro: '{self.titulo}', Autor: {self.autor}, "
        f"Campo de estudio: {self.campo_estudio}, Nivel: {self.nivel_especializacion}"
    )


# Instancia y prueba
libro_esp = LibroEspecializado(
    "Clean Code", "Robert C. Martin", "Ingeniería de Software", "avanzado"
)
print(libro_esp.obtener_detalles())
