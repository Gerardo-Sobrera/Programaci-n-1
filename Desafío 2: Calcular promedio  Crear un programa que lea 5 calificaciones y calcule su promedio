def calcular_promedio_calificaciones():
    """Programa que solicita 5 calificaciones, valida la entrada 
    y calcula el promedio final.
    """
    calificaciones = []
    print("--- Calculadora de Promedio de 5 Calificaciones ---")
    
    # Bucle para solicitar exactamente 5 calificaciones
    for i in range(1, 6):
        while True:
            try:
                calificacion = float(input(f"Ingrese la calificación {i} (de 0 a 100): "))
                calificaciones.append(calificacion)
                break
            except ValueError:
                print("Error: Por favor, ingrese un valor numérico válido.")
                
    # Cálculo del promedio
    suma_total = sum(calificaciones)
    promedio = suma_total / len(calificaciones)
    
    # Resultados
    print("\n--- Resultados ---")
    print(f"Calificaciones ingresadas: {calificaciones}")
    print(f"El promedio final es: {promedio:.2f}")

# Bloque principal de ejecución
if __name__ == "__main__":
    calcular_promedio_calificaciones()
