class Autor:
    """Clase que representa a un autor y gestiona su catálogo de obras."""

    def __init__(self, nombre: str, nacionalidad: str):
        self.nombre = nombre
        self.nacionalidad = nacionalidad
        self.libros = []  # Relación 1-a-N: Almacena objetos de tipo Libro

    def agregar_libro(self, libro) -> bool:
        """Añade un objeto Libro a la lista del autor evitando duplicados por ISBN."""
        if libro not in self.libros:
            self.libros.append(libro)
            return True
        return False

    def eliminar_libro(self, isbn: str) -> bool:
        """Elimina un libro del catálogo del autor mediante su ISBN."""
        for libro in self.libros:
            if libro.isbn == isbn:
                self.libros.remove(libro)
                print(f'✔ Libro "{libro.titulo}" eliminado del catálogo de {self.nombre}.')
                return True
        print(f'✖ No se encontró el libro con ISBN {isbn} en el catálogo de {self.nombre}.')
        return False

    def mostrar_informacion(self):
        """Muestra la información detallada del autor y sus obras asociadas."""
        print(f"\n--- AUTOR: {self.nombre} ({self.nacionalidad}) ---")
        if not self.libros:
            print(" No tiene libros registrados en su catálogo.")
            return

        print(" Libros publicados:")
        for i, libro in enumerate(self.libros, 1):
            print(f"   {i}. \"{libro.titulo}\" | Género: {libro.genero} | ISBN: {libro.isbn}")
        print("-" * (30 + len(self.nombre)))


class Libro:
    """Clase que representa a un libro con sus atributos esenciales y su autor."""

    def __init__(self, titulo: str, genero: str, isbn: str, autor: Autor):
        self.titulo = titulo
        self.genero = genero
        self.isbn = isbn
        self.autor = autor  # Relación: Atributo que hace referencia al objeto Autor

        # Vinculación bidireccional automática
        if self.autor and isinstance(self.autor, Autor):
            self.autor.agregar_libro(self)

    def mostrar_detalle(self):
        """Muestra los detalles completos del libro."""
        nombre_autor = self.autor.nombre if self.autor else "Desconocido"
        print(f'📖 "{self.titulo}" | Autor: {nombre_autor} | Género: {self.genero} | ISBN: {self.isbn}')


