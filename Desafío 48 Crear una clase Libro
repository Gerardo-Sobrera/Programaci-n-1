if __name__ == "__main__":
    # 1. Crear instancia de Autor
    autor1 = Autor("Gabriel García Márquez", "Colombiana")
    autor2 = Autor("George Orwell", "Británica")

    # 2. Crear instancias de Libro asociadas a sus respectivos autores
    libro1 = Libro(
        titulo="Cien años de soledad",
        genero="Realismo mágico",
        isbn="978-0307474728",
        autor=autor1
    )
    libro2 = Libro(
        titulo="El amor en los tiempos del cólera",
        genero="Novela romántica",
        isbn="978-0307389732",
        autor=autor1
    )
    libro3 = Libro(
        titulo="1984",
        genero="Distopía / Ciencia Ficción",
        isbn="978-0451524935",
        autor=autor2
    )

    # 3. Mostrar detalle individual desde el objeto Libro
    print("=== 1. DETALLE DE LIBROS INDIVIDUALES ===")
    libro1.mostrar_detalle()
    libro3.mostrar_detalle()

    # 4. Mostrar información del Autor (incluye la lista de sus libros)
    print("\n=== 2. INFORMACIÓN DEL AUTOR Y SUS OBRAS ===")
    autor1.mostrar_informacion()

    # 5. Probar eliminación de un libro desde el Autor usando el ISBN
    print("\n=== 3. ELIMINACIÓN DE UN LIBRO DEL CATALOGO DEL AUTOR ===")
    autor1.eliminar_libro("978-0307389732")  # Elimina "El amor en los tiempos del cólera"

    # 6. Estado final del catálogo del autor
    autor1.mostrar_informacion()

