# Definimos el número a evaluar
numero = 7

# Clasificación según su signo
if numero > 0:
    signo = "positivo"
elif numero < 0:
    signo = "negativo"
else:
    signo = "cero"

# Clasificación según su paridad
if numero != 0:
    if numero % 2 == 0:
        paridad = "par"
    else:
        paridad = "impar"
else:
    paridad = "neutro"

print(f"El número {numero} es {signo} y es {paridad}.")
