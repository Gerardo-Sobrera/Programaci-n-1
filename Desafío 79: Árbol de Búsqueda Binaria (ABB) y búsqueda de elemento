class NodoBST:

  def __init__(self, valor):
    self.valor = valor
    self.izquierdo = None
    self.derecho = None


def insertar_bst(nodo, valor):
  if nodo is None:
    return NodoBST(valor)
  if valor < nodo.valor:
    nodo.izquierdo = insertar_bst(nodo.izquierdo, valor)
  elif valor > nodo.valor:
    nodo.derecho = insertar_bst(nodo.derecho, valor)
  return nodo


def buscar_bst(nodo, valor):
  if nodo is None or nodo.valor == valor:
    return nodo is not None  # Retorna True si existe, False si es None
  if valor < nodo.valor:
    return buscar_bst(nodo.izquierdo, valor)
  return buscar_bst(nodo.derecho, valor)


# Construcción del ABB con números enteros únicos
numeros = [10, 5, 15, 3, 7, 12, 20]
raiz_bst = None
for num in numeros:
  raiz_bst = insertar_bst(raiz_bst, num)

# Prueba de búsqueda
buscado = 7
existe = buscar_bst(raiz_bst, buscado)
print(f"¿El número {buscado} existe en el ABB? {existe}")
