if __name__ == "__main__":
    # 1. Instanciación del autor (Comprobación de inicialización)
    autor1 = Autor("Gabriel García Márquez", "Colombiano")

    # 2. Prueba del método agregar_libro
    print("=== 1. AGREGANDO LIBROS ===")
    autor1.agregar_libro("Cien años de soledad")
    autor1.agregar_libro("El amor en los tiempos del cólera")
    autor1.agregar_libro("Crónica de una muerte anunciada")
    
    # Intento de duplicado para validar control de errores
    autor1.agregar_libro("Cien años de soledad")

    # Visualización de la lista
    autor1.mostrar_obras()

    # 3. Prueba del método eliminar_libro
    print("\n=== 2. ELIMINANDO LIBROS ===")
    autor1.eliminar_libro("Crónica de una muerte anunciada")
    
    # Intento de eliminar un libro inexistente
    autor1.eliminar_libro("La hojarasca")

    # 4. Estado final del objeto
    autor1.mostrar_obras()


