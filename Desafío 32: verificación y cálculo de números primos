import math
def es_primo(numero: int) -> bool:
"""
Evalúa si un número entero es primo.
"""
# Los números menores o iguales a 1 no son primos
if numero <= 1:
return False
# El 2 es el único número primo par
if numero == 2:
return True
# Descartar todos los demás números pares
if numero % 2 == 0:
return False
# Evaluar divisores impares desde 3 hasta la raíz cuadrada del número
limite_busqueda = int(math.isqrt(numero))
for i in range(3, limite_busqueda + 1, 2):
if numero % i == 0:
return False # Divisor encontrado, no es primo
return True # Es primo
def contar_primos_en_lista(lista_numeros: list) -> int:
"""
Cuenta la cantidad de números primos en una lista.
"""
contador = 0
for num in lista_numeros:
# Validación defensiva por si la lista contiene tipos no enteros
if isinstance(num, int):
if es_primo(num):
contador += 1
return contador
