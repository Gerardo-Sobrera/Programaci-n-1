class Autor:
    def __init__(self, nombre: str, nacionalidad: str):
        # Usamos los setters desde el constructor para aplicar las validaciones
        self.nombre = nombre
        self.nacionalidad = nacionalidad

    # --- Getter y Setter para Nombre ---
    @property
    def nombre(self) -> str:
        return self._nombre

    @nombre.setter
    def nombre(self, valor: str):
        if not valor or not valor.strip():
            raise ValueError("El nombre no puede estar vacío.")
        self._nombre = valor.strip()

    # --- Getter y Setter para Nacionalidad ---
    @property
    def nacionalidad(self) -> str:
        return self._nacionalidad

    @nacionalidad.setter
    def nacionalidad(self, valor: str):
        if not valor or not valor.strip():
            raise ValueError("La nacionalidad no puede estar vacía.")
        self._nacionalidad = valor.strip()


# --- Demostración del uso ---
if __name__ == "__main__":
    # 1. Crear un objeto Autor
    autor1 = Autor("Mario Benedetti", "Uruguaya")

    # 2. Mostrar datos mediante @property
    print("--- Datos Iniciales ---")
    print(f"Nombre: {autor1.nombre}")
    print(f"Nacionalidad: {autor1.nacionalidad}\n")

    # 3. Modificar datos con los setters
    autor1.nombre = "Gabriel García Márquez"
    autor1.nacionalidad = "Colombiana"
    print("--- Datos Modificados ---")
    print(f"Nombre: {autor1.nombre}")
    print(f"Nacionalidad: {autor1.nacionalidad}\n")

    # 4. Intentar asignar una cadena vacía para observar la respuesta
    print("--- Prueba de Validación ---")
    try:
        autor1.nombre = "   "  # Cadena vacía o solo espacios
    except ValueError as e:
        print(f"Error detectado en nombre: {e}")

    try:
        autor1.nacionalidad = ""
    except ValueError as e:
        print(f"Error detectado en nacionalidad: {e}")

