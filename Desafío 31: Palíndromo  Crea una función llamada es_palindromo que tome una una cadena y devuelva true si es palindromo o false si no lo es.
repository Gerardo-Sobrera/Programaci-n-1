def es_palindromo(cadena):
    """Toma una cadena y devuelve True si es palíndromo o False si no lo es.
    Ignora espacios, mayúsculas y signos de puntuación para mayor precisión.
    """
    # 1. Convertimos todo a minúsculas y filtramos solo los caracteres alfanuméricos
    cadena_limpia = "".join(caracter for caracter in cadena.lower() if caracter.isalnum())
    
    # 2. Comparamos la cadena limpia con su versión invertida ([::-1])
    return cadena_limpia == cadena_limpia[::-1]

