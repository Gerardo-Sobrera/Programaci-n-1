import math


class Figura:

  def area(self):
    pass


class Circulo(Figura):

  def __init__(self, radio):
    self.radio = radio

  def area(self):
    return math.pi * (self.radio**2)


class Cuadrado(Figura):

  def __init__(self, lado):
    self.lado = lado

  def area(self):
    return self.lado**2


# Demostración de polimorfismo
figuras = [Circulo(4), Cuadrado(5)]

for figura in figuras:
  print(f"El área calculada es: {figura.area():.2f}")
