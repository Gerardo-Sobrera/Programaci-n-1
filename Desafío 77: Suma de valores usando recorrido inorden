def suma_inorden(nodo):
  if nodo is None:
    return 0

  # Inorden: Izquierdo -> Raíz -> Derecho
  suma_izq = suma_inorden(nodo.izquierdo)
  suma_actual = nodo.valor
  suma_der = suma_inorden(nodo.derecho)

  return suma_izq + suma_actual + suma_der


