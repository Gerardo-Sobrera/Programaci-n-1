"""
Módulo personalizado: formato_texto.py
Proporciona funciones para dar formato al texto en la consola utilizando códigos de escape ANSI.
"""

# Constantes de estilos ANSI
RESET = "\033[0m"
NEGRITA = "\033[1m"
ATENUADO = "\033[2m"
ITALICA = "\033[3m"
SUBRAYADO = "\033[4m"
PARPADEO = "\033[5m"
INVERTIDO = "\033[7m"

# Constantes de colores de texto
ROJO = "\033[31m"
VERDE = "\033[32m"
AMARILLO = "\033[33m"
AZUL = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"


def negrita(texto: str) -> str:
    """Devuelve el texto formateado en negrita."""
    return f"{NEGRITA}{texto}{RESET}"


def italica(texto: str) -> str:
    """Devuelve el texto formateado en itálica (cursiva)."""
    return f"{ITALICA}{texto}{RESET}"


def subrayado(texto: str) -> str:
    """Devuelve el texto con un subrayado."""
    return f"{SUBRAYADO}{texto}{RESET}"


def colorear(texto: str, color: str = ROJO) -> str:
    """Aplica un color específico al texto recibido. Por defecto usa rojo."""
    return f"{color}{texto}{RESET}"


def estilo_personalizado(texto: str, *estilos: str) -> str:
    """
    Aplica múltiples estilos o colores a un texto de forma simultánea.
    
    Ejemplo de uso:
        estilo_personalizado("Texto", NEGRITA, ROJO, SUBRAYADO)
    """
    prefijo = "".join(estilos)
    return f"{prefijo}{texto}{RESET}"

