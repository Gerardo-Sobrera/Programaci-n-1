def es_primo(n):
    """Verifica si un número entero dado es primo.
    Retorna True si es primo, de lo contrario False.
    Un número primo es aquel mayor a 1 que solo es divisible por 1 y por sí mismo.
    """
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    
    # Optimizador: comprobamos divisores hasta la raíz cuadrada del número
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

def contar_primos(lista_numeros):
    """Toma una lista de números y cuenta cuántos de ellos son primos,
    apoyándose en la función es_primo().
    """
    contador = 0
    for numero in lista_numeros:
        if es_primo(numero):
            contador += 1
    return contador

