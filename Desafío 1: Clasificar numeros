def clasificar_tres_numeros(a, b, c):
    """Clasifica tres números distintos en orden ascendente 
    utilizando operadores lógicos y comparaciones.
    """
    if (a < b) and (b < c):
        return a, b, c
    elif (a < c) and (c < b):
        return a, c, b
    elif (b < a) and (a < c):
        return b, a, c
    elif (b < c) and (c < a):
        return b, c, a
    elif (c < a) and (a < b):
        return c, a, b
    else:
        return c, b, a

# --- Bloque principal de ejecución ---
if __name__ == "__main__":
    print("--- Clasificador de 3 Números en Orden Ascendente ---")
    
    # Solicitamos los números al usuario
    num1 = float(input("Ingrese el primer número: "))
    num2 = float(input("Ingrese el segundo número: "))
    num3 = float(input("Ingrese el tercer número: "))
    
    # Obtenemos los números ordenados
    primero, segundo, tercero = clasificar_tres_numeros(num1, num2, num3)
    
    # Mostramos el resultado
    print(f"Los números en orden ascendente son: {primero}, {segundo}, {tercero}")
