def autor_con_mas_libros(lista_autores):
  """Recibe una lista de objetos Autor y devuelve el que ha escrito más libros."""
  if not lista_autores:
    return None

  # Encontramos el autor con el mayor número usando el método encapsulado
  autor_destacado = max(
      lista_autores, key=lambda autor: autor.obtener_cantidad_libros()
  )
  return autor_destacado
